rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /expenses/{expenseId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['amount', 'category', 'note', 'date', 'createdAt'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 10000000
          && request.resource.data.category in ['Food', 'Transport', 'Bills', 'Shopping', 'Health', 'Education', 'Entertainment', 'Other']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 200
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && request.resource.data.createdAt == request.time;
      }

      // Utang ledger: one document per money event (lent, borrowed, they_paid, i_paid).
      // Entries are never edited. There is no "update" rule, so updates are denied.
      // Balances are not stored; the app adds up the entries.
      match /ledger/{entryId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['friendName', 'friendKey', 'type', 'amount', 'note', 'date', 'createdAt'])
          && request.resource.data.keys().hasOnly(['friendName', 'friendKey', 'type', 'amount', 'note', 'date', 'createdAt'])
          && request.resource.data.friendName is string
          && request.resource.data.friendName.size() >= 1
          && request.resource.data.friendName.size() <= 40
          && request.resource.data.friendKey is string
          && request.resource.data.friendKey.size() >= 1
          && request.resource.data.friendKey.size() <= 40
          && request.resource.data.type in ['lent', 'borrowed', 'they_paid', 'i_paid']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 10000000
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 200
          && request.resource.data.date is string
          && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
